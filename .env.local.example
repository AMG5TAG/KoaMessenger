# Copy this file to .env.local and fill in your values
# Then run: set -a && source .env.local && set +a && pnpm start:desktop

# Required: PostgreSQL connection string
# Option A — use a free cloud DB: https://neon.tech or https://supabase.com
# Option B — local Postgres: postgresql://localhost/koamessenger
DATABASE_URL=postgresql://user:password@host/dbname
