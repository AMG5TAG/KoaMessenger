{
  "name": "@workspace/koa-messenger-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "KoaMessenger desktop shell (Electron) — true per-account isolation via webview partitions.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/build.mjs",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm run build && electron-builder"
  },
  "build": {
    "appId": "au.com.koapos.koamessenger",
    "productName": "KoaMessenger",
    "files": ["dist/**/*", "package.json", "build/**/*"],
    "directories": { "output": "release" },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.2"
  }
}
